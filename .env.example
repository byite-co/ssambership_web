# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 새 키 체계(publishable) 우선, 없으면 anon 키를 사용합니다. 둘 중 하나는 필수.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 클라이언트에 노출 금지.
# 관리자 콘솔의 상당수가 이 키에 의존합니다: 계정 관리(users/user_warnings),
# 정산·지급(payout_runs 등 RLS 정책 없는 테이블), 환불 승인/거절 RPC(service_role 전용),
# SLA 대시보드, 커뮤니티 직접 검수, 멘토 승인 폴백 경로.
# 미설정 시 해당 화면은 에러 없이 비어 보이거나 처리 버튼이 실패합니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 토스페이먼츠 (테스트 키) ─────────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
# Toss 대시보드 > 웹훅 설정에서 발급 (TOSS_SECRET_KEY와 별도).
# ⚠ 결제 이벤트(PAYMENT_STATUS_CHANGED 등)에는 서명 헤더가 오지 않는다 — Toss 는
#   payout.changed / seller.changed 에만 서명을 붙인다(공식 문서 webhook-events).
#   따라서 캐시 충전 웹훅은 이 값 없이도 동작하며, 보안 근거는 적립 전 Toss 재조회
#   정본 대조다. 이 값은 향후 payout/seller 이벤트를 처리할 때 필요하다(현재 미사용).
TOSS_WEBHOOK_SECRET=
# 토스 심사 게이트 — 카드 결제를 허용할 심사용 계정 UUID(쉼표 구분). 서버 전용.
# 미설정·빈 값 = 전원 차단(일반 계정 충전 수단은 페이싱크 무통장입금).
TOSS_REVIEW_ALLOWED_USER_IDS=

# ── 사이트 ──────────────────────────────────────────────────────────────────
# 운영(Vercel Production)은 반드시 apex 인 https://ssambership.com 을 넣습니다.
# `www.` 를 넣으면 네이버 서치어드바이저 사이트맵 도메인 검증에 걸립니다(소유확인이 apex 로 되어 있음).
# 코드에 정규화 안전장치가 있지만, env 자체를 apex 로 두는 것이 정본입니다.
# 이 값이 robots.txt·sitemap.xml 의 절대 URL 과 OG/canonical 의 metadataBase 를 결정합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── NICE 통합인증 (S-C — 전부 서버 전용, NEXT_PUBLIC_ 승격 금지) ─────────────
# NICE 발급값. 레포 커밋 절대 금지.
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
# Gabia 고정IP 프록시 URL (직접 호출 금지 — 예: https://nice-proxy.<도메인>)
NICE_API_BASE=
# 프록시 X-Proxy-Key 공유 시크릿
NICE_PROXY_KEY=
# 32byte(base64) — ci/di/휴대폰번호 AES-256-GCM 암호화 키
IDENTITY_DATA_KEY=
# di_hash HMAC-SHA256 키 (16자 이상)
IDENTITY_HASH_KEY=
# return_url 조립용 — 미설정 시 NEXT_PUBLIC_SITE_URL 재사용
APP_URL=
# 본인인증 게이트 롤아웃 플래그 — 미설정 또는 'true' 외 = 게이트 OFF.
# 배포 순서: off로 배포 → 스테이징 실측 → on. 인증 플로우 자체는 상시 활성.
IDENTITY_GATE_ENABLED=

# ── 알림 outbox 푸시 워커 (App-F1 — 전부 서버 전용, NEXT_PUBLIC_ 승격 금지) ──
# FCM 발송 대상 Firebase 프로젝트 ID (예: ssambership-production)
FCM_PROJECT_ID=
# Firebase 서비스 계정 키 JSON 을 base64 1줄로 — 원본 JSON 은 레포·채팅·로그 절대 금지(O-6)
FCM_SERVICE_ACCOUNT_JSON_B64=
# outbox 발송 워커 on/off — 미설정=false. 활성은 O-8 순서(워커 ON → 플래그 ON → live)로만
NOTIFICATION_OUTBOX_WORKER_ENABLED=
# 'live' 정확 일치만 실발송, 미설정·그 외 전부 dry-run(발송 0, 상태 전이만)
FCM_TRANSPORT_MODE=

# ── 페이싱크 무통장입금 (Phase 1~3 — 전부 서버 전용, NEXT_PUBLIC_ 승격 금지) ──
# REST API 키 (https://api.paysync.kr/v1, Authorization: Bearer)
PAYSYNC_API_KEY=
# 웹훅 서명 시크릿 — 대시보드 '웹훅 관리'에서 엔드포인트 생성 시 발급된다.
# 반드시 `whsec_` 로 시작하는 값이다(엔드포인트 URL 이 아니다 — 형식이 어긋나면
# 수신 로그에 signature=invalid reason=secret_malformed 로 남는다).
PAYSYNC_WEBHOOK_SECRET=
# 입금 안내 화면에 표시할 실계좌 정보
PAYSYNC_DEPOSIT_BANK_NAME=
PAYSYNC_DEPOSIT_ACCOUNT_NUMBER=
PAYSYNC_DEPOSIT_ACCOUNT_HOLDER=
