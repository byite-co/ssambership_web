# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 새 키 체계(publishable) 우선, 없으면 anon 키를 사용합니다. 둘 중 하나는 필수.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 클라이언트에 노출 금지.
# 관리자 콘솔의 상당수가 이 키에 의존합니다: 계정 관리(users/user_warnings),
# 정산·지급(payout_runs 등 RLS 정책 없는 테이블), 환불 승인/거절 RPC(service_role 전용),
# SLA 대시보드, 커뮤니티 직접 검수, 멘토 승인 폴백 경로.
# 미설정 시 해당 화면은 에러 없이 비어 보이거나 처리 버튼이 실패합니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 토스페이먼츠 (테스트 키) ─────────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
# Toss 대시보드 > 웹훅 설정에서 발급 (TOSS_SECRET_KEY와 별도)
TOSS_WEBHOOK_SECRET=

# ── 사이트 ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
